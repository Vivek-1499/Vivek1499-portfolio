# =========================================================
# Resend Email Configuration (https://resend.com)
# =========================================================

# Your secret Resend API Key (starts with re_...)
# Get yours from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# The destination email address where you will receive portfolio messages
RESEND_TO_EMAIL=vivek.pandit1499@gmail.com

# The sender address.
# Default free test domain: onboarding@resend.dev (sends to your account email: vivek.pandit1499@gmail.com)
# When you verify your own custom domain on Resend (e.g., contact@vivekpandit.dev), you can set it here:
RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
